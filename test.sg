Inner :: struct
{
	a: i32;
}

test2 :: (self: Inner): i32
{
	self.a
}

Values :: struct
{
    a: i32;
	b: i32;
	c: i32;
	d: Inner;
}

sum :: (self: Values): i32
{
	test :: (): i32 {
		self.a + self.b + self.c + self.d.a
	};

	test()
}

mul :: (self: Values): i32
{
	self.a * self.b * self.c
}

main :: (): i32
{
	c := []i32{666, 64};

	printf("%d !=", c[0]);

	result := c[1];

	s := Values {
		a: 0,
		b: 0,
		c: 0,
		d: Inner {
			a: 13,
		}
	};

	printf("%d", s.sum());

	0
}

